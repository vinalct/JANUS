{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/metrics-ndjson-v1.json",
  "title": "JANUS metrics batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["emitted_at", "scope", "labels", "samples"],
  "properties": {
    "emitted_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["run", "pipeline"]},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "strategy_family": {"type": "string", "minLength": 1},
        "strategy_variant": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "value"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"},
          "type": {"enum": ["gauge", "counter"]},
          "value": {"type": "number"},
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {"status": {"enum": ["succeeded", "failed", "skipped"]}}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "run"}}},
      "then": {"properties": {"samples": {"items": {"properties": {"labels": false}}}}},
      "else": {
        "properties": {
          "labels": {
            "required": ["environment", "trigger"],
            "propertyNames": {"enum": ["environment", "trigger"]}
          }
        }
      }
    }
  ]
}
