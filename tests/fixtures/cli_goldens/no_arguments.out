{
  "environment": "local",
  "paths": {
    "bronze_dir": "<project-root>/data/bronze",
    "iceberg_catalog_db": "<project-root>/data/metadata/iceberg-catalog/catalog.sqlite",
    "iceberg_warehouse_dir": "<project-root>/data/bronze/iceberg",
    "ivy_dir": "<project-root>/data/metadata/ivy",
    "metadata_dir": "<project-root>/data/metadata",
    "raw_dir": "<project-root>/data/raw",
    "root_dir": "<project-root>/data",
    "warehouse_dir": "<project-root>/data/metadata/spark-warehouse"
  },
  "project_root": "<project-root>",
  "spark": {
    "app_name": "janus-local",
    "config": {
      "spark.driver.bindAddress": "127.0.0.1",
      "spark.driver.host": "127.0.0.1",
      "spark.driver.maxResultSize": "2g",
      "spark.driver.memory": "8g",
      "spark.sql.adaptive.enabled": "true",
      "spark.sql.files.maxPartitionBytes": "134217728",
      "spark.sql.session.timeZone": "UTC",
      "spark.sql.shuffle.partitions": "256",
      "spark.ui.enabled": "false"
    },
    "master": "local[*]"
  }
}
