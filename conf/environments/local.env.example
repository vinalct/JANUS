JANUS_LOG_LEVEL=INFO
JANUS_SPARK_APP_NAME=janus-local
JANUS_SPARK_MASTER=local[*]
JANUS_SPARK_DRIVER_BIND_ADDRESS=127.0.0.1
JANUS_SPARK_DRIVER_HOST=127.0.0.1
JANUS_SPARK_WAREHOUSE_DIR=data/metadata/spark-warehouse
JANUS_SPARK_IVY_DIR=data/metadata/ivy
JANUS_ICEBERG_CATALOG_NAME=janus
JANUS_ICEBERG_CATALOG_TYPE=jdbc
JANUS_ICEBERG_WAREHOUSE_DIR=data/bronze/iceberg
JANUS_ICEBERG_RUNTIME_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.0_2.13:1.10.1
JANUS_ICEBERG_DEFAULT_NAMESPACE=bronze
# The catalog database: project-relative, resolved to an absolute path at runtime. The query
# parameters are xerial-driver PRAGMAs — WAL journaling plus a busy timeout, so two concurrent
# committers serialize on the database lock instead of failing fast with SQLITE_BUSY.
JANUS_ICEBERG_CATALOG_URI=jdbc:sqlite:data/metadata/iceberg-catalog/catalog.sqlite?journal_mode=WAL&busy_timeout=30000
# Vendored under deps/ and seeded into the Ivy cache by `make seed-ivy` — never fetched at run
# or test time. Keep the version in lockstep with deps/ and the Makefile's SQLITE_JAR_NAME.
JANUS_ICEBERG_JDBC_DRIVER_PACKAGE=org.xerial:sqlite-jdbc:3.53.2.1
# SQLite names a file, not a server: leave both empty. They exist for the Postgres-backed
# catalog the cluster profile uses.
JANUS_ICEBERG_CATALOG_USER=
JANUS_ICEBERG_CATALOG_PASSWORD=
JANUS_DATA_ROOT=data
JANUS_RAW_DIR=data/raw
JANUS_BRONZE_DIR=data/bronze
JANUS_METADATA_DIR=data/metadata
