# The REST-catalog overlay on the `cluster` profile.
#
# Same conf/environments/cluster.yaml, same MinIO bucket, same S3FileIO write path. Only the
# catalog changes: instead of opening Postgres over JDBC itself, JANUS talks the Iceberg REST
# protocol to a catalog service that owns that connection. That is why there is no second
# profile — every key cluster.yaml declares is an expansion, and the three lines under
# "the catalog" below are the whole difference.
#
# Bring it up with `make up-cluster-rest`; run against it with `make run-cluster-rest`.
# `make test-cluster-rest` re-runs the atomicity and engine-neutrality suites over it.

JANUS_LOG_LEVEL=INFO
JANUS_SPARK_APP_NAME=janus-cluster-rest
JANUS_SPARK_MASTER=local[*]
JANUS_SPARK_DRIVER_BIND_ADDRESS=127.0.0.1
JANUS_SPARK_DRIVER_HOST=127.0.0.1
JANUS_SPARK_WAREHOUSE_DIR=data/metadata/spark-warehouse
JANUS_SPARK_IVY_DIR=data/metadata/ivy
JANUS_SPARK_SHUFFLE_PARTITIONS=200

JANUS_ICEBERG_CATALOG_NAME=janus
JANUS_ICEBERG_RUNTIME_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.0_2.13:1.10.1
JANUS_ICEBERG_DEFAULT_NAMESPACE=bronze
JANUS_ICEBERG_CATALOG_TYPE=rest
JANUS_ICEBERG_CATALOG_URI=http://nessie:19120/iceberg/main
JANUS_ICEBERG_WAREHOUSE_DIR=janus
JANUS_ICEBERG_JDBC_DRIVER_PACKAGE=
JANUS_ICEBERG_CATALOG_USER=
JANUS_ICEBERG_CATALOG_PASSWORD=
JANUS_ICEBERG_CATALOG_TOKEN=
JANUS_ICEBERG_CATALOG_CREDENTIAL=
JANUS_ICEBERG_CATALOG_OAUTH2_SERVER_URI=
JANUS_ICEBERG_CATALOG_SCOPE=

# ── unchanged from cluster.env.example: the warehouse still lives on object storage ──
JANUS_ICEBERG_OBJECT_STORE_PACKAGE=org.apache.iceberg:iceberg-aws-bundle:1.10.1
JANUS_S3_ENDPOINT=http://minio:9000
JANUS_S3_PATH_STYLE_ACCESS=true
JANUS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JANUS_DATA_ROOT=data
JANUS_RAW_DIR=data/raw
JANUS_BRONZE_DIR=data/bronze
JANUS_METADATA_DIR=data/metadata
