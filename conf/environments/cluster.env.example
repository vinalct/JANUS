# Environment for the `cluster` profile — the object-store + Postgres-catalog PoC stack.
#
# This file is the janus-cluster container's env: it mirrors conf/environments/cluster.yaml's
# checked-in defaults, and it carries NO credentials. The stack's login details are generated
# per machine into conf/environments/cluster.env (untracked, .gitignore'd) by
# `make cluster-secrets`, which `make up-cluster` runs for you, and reach the containers as
# compose `environment:` entries that override the empty placeholders below.
#
# Nothing here names MinIO as a product: swapping in real S3 and a managed Postgres is
# JANUS_S3_ENDPOINT plus JANUS_ICEBERG_CATALOG_URI, with no code change (NFR-1).

JANUS_LOG_LEVEL=INFO
JANUS_SPARK_APP_NAME=janus-cluster
JANUS_SPARK_MASTER=local[*]
JANUS_SPARK_DRIVER_BIND_ADDRESS=127.0.0.1
JANUS_SPARK_DRIVER_HOST=127.0.0.1
JANUS_SPARK_WAREHOUSE_DIR=data/metadata/spark-warehouse
JANUS_SPARK_IVY_DIR=data/metadata/ivy
JANUS_SPARK_SHUFFLE_PARTITIONS=200

JANUS_ICEBERG_CATALOG_NAME=janus
JANUS_ICEBERG_CATALOG_TYPE=jdbc
JANUS_ICEBERG_WAREHOUSE_DIR=s3://janus-bronze/warehouse
JANUS_ICEBERG_RUNTIME_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.0_2.13:1.10.1
JANUS_ICEBERG_DEFAULT_NAMESPACE=bronze
JANUS_ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg
JANUS_ICEBERG_JDBC_DRIVER_PACKAGE=org.postgresql:postgresql:42.7.13
JANUS_ICEBERG_CATALOG_USER=
JANUS_ICEBERG_CATALOG_PASSWORD=

# The Iceberg AWS bundle carries S3FileIO's AWS SDK. It is the one jar NOT committed under
# deps/ (59.8 MiB); `make seed-cluster-jars` fetches and sha256-verifies it once, at
# `make up-cluster` time, into the same Ivy cache the offline rule uses.
JANUS_ICEBERG_OBJECT_STORE_PACKAGE=org.apache.iceberg:iceberg-aws-bundle:1.10.1
JANUS_S3_ENDPOINT=http://minio:9000
JANUS_S3_PATH_STYLE_ACCESS=true
JANUS_S3_REGION=us-east-1
# Placeholders. S3FileIO reads these two itself, which is why no object-store credential
# appears in cluster.yaml — `make cluster-secrets` writes the real values into cluster.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The raw and metadata zones stay on the mounted volume in this PoC; only the Iceberg
# warehouse moves to object storage.
JANUS_DATA_ROOT=data
JANUS_RAW_DIR=data/raw
JANUS_BRONZE_DIR=data/bronze
JANUS_METADATA_DIR=data/metadata
